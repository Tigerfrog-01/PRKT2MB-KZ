<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projekt2_TARpe24_Kristopher.Views.ExplorePage"
             x:Name="ExploreRoot"
             Title="{Binding ExploreTitle}"
             BackgroundColor="#F8FAFC">
    <Grid RowDefinitions="Auto,*" Padding="18,18,18,12" RowSpacing="14">
        <VerticalStackLayout Spacing="4">
            <Label Text="{Binding AppTitle}"
                   FontAttributes="Bold"
                   FontSize="28"
                   TextColor="#0F172A" />
            <Label Text="{Binding ExploreIntro}"
                   FontSize="14"
                   TextColor="#475569" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,62" ColumnSpacing="12">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <Label Text="{Binding SelectedCategoryTitle}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <CarouselView x:Name="PlacesCarousel"
                              Grid.Row="1"
                              ItemsSource="{Binding Places}"
                              IndicatorView="PlacesIndicator"
                              PeekAreaInsets="22,0"
                              HeightRequest="430">
                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="0"
                                    BackgroundColor="#111827"
                                    Margin="4"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#24000000" Offset="0,8" Radius="16" Opacity="0.3" />
                                </Border.Shadow>
                                <Grid>
                                    <Image Source="{Binding ImageName}"
                                           Aspect="AspectFill" />
                                    <BoxView Color="#990F172A"
                                             HeightRequest="160"
                                             VerticalOptions="End" />
                                    <VerticalStackLayout Spacing="8"
                                                         Padding="18"
                                                         VerticalOptions="End">
                                        <Label Text="{Binding Name}"
                                               FontSize="24"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                        <Label Text="{Binding ShortDescription}"
                                               FontSize="14"
                                               MaxLines="3"
                                               TextColor="#E2E8F0" />
                                    </VerticalStackLayout>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="PlaceTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <IndicatorView x:Name="PlacesIndicator"
                               Grid.Row="2"
                               HorizontalOptions="Center"
                               IndicatorColor="#CBD5E1"
                               SelectedIndicatorColor="#0F766E" />
            </Grid>

            <CollectionView Grid.Column="1"
                            ItemsSource="{Binding Categories}"
                            SelectionMode="None"
                            VerticalOptions="Center">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Button Text="{Binding Emoji}"
                                FontSize="26"
                                WidthRequest="52"
                                HeightRequest="52"
                                Padding="0"
                                Margin="0,4"
                                BackgroundColor="#E0F2FE"
                                TextColor="#0F172A"
                                Command="{Binding BindingContext.SelectCategoryCommand, Source={x:Reference ExploreRoot}}"
                                CommandParameter="{Binding .}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
