<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projekt2_TARpe24_Kristopher.TripsPea"
             Title="TripsPea"
             BackgroundColor="#D2923E">
    <ScrollView>
        <VerticalStackLayout x:Name="MainStack" 
                             Padding="20" 
                             Spacing="15" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center">

            
            
            
            <Button Text="Seaded"
                    FontSize="22"
                    BackgroundColor="#A0522D"
                    TextColor="White"
                    HeightRequest="60"
                    WidthRequest="250"
                    CornerRadius="10"
                    Clicked="OnSettingsClicked" />

            <Button Text="Edetabel"
                    FontSize="22"
                    BackgroundColor="#A0522D"
                    TextColor="White"
                    HeightRequest="60"
                    WidthRequest="250"
                    CornerRadius="10"
                    Clicked="OnLeaderboardClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>