<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projekt2_TARpe24_Kristopher.Lumememm"
             Title="Lumememm">




    <Grid BackgroundColor="SkyBlue">

        <Grid.RowDefinitions>

            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

            <RowDefinition Height="20" />

        </Grid.RowDefinitions>

        <Button x:Name="Melt" HeightRequest="10" WidthRequest="100" Text="Sulata"></Button>
        <Button x:Name="UnMelt" HeightRequest="10" WidthRequest="100" Text="Sulata"></Button>
        <BoxView x:Name="Paike" Opacity="0" WidthRequest="150" HeightRequest="150" CornerRadius="50" BackgroundColor="Yellow"></BoxView>


        <BoxView x:Name="Grid1" Grid.Row="1" HeightRequest="100" WidthRequest="100" BackgroundColor="Transparent" Color="Grey" HorizontalOptions="Center" CornerRadius="15" />

        <BoxView x:Name="Grid2" Grid.Row="2" CornerRadius="75" HeightRequest="150" WidthRequest="150" BackgroundColor="Transparent" Color="White" HorizontalOptions="Center" />

        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" VerticalOptions="Center" Spacing="40" Margin="0,0,0,20">

            <Frame BackgroundColor="Black" CornerRadius="25" HeightRequest="30" WidthRequest="30" />

            <Frame BackgroundColor="Black" CornerRadius="25" HeightRequest="30" WidthRequest="30" />
        </HorizontalStackLayout>

        <BoxView x:Name="Grid3" Grid.Row="3" CornerRadius="100" HeightRequest="200" WidthRequest="200" BackgroundColor="Transparent" Color="White" HorizontalOptions="Center" Margin="0,-15,0,0" />

        <VerticalStackLayout Grid.Row="3" HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">

            <Frame BackgroundColor="Black" CornerRadius="10" HeightRequest="25" WidthRequest="25" />
            <Frame BackgroundColor="Black" CornerRadius="10" HeightRequest="25" WidthRequest="25" />
            <Frame BackgroundColor="Black" CornerRadius="10" HeightRequest="25" WidthRequest="25" />


        </VerticalStackLayout>

        <BoxView x:Name="Grid4" Grid.Row="4" CornerRadius="125" HeightRequest="250" WidthRequest="250" BackgroundColor="Transparent" Color="White" HorizontalOptions="Center" Margin="0,-25,0,0" />
        <VerticalStackLayout Grid.Row="4" HorizontalOptions="Center" VerticalOptions="Start" Spacing="15">


            <Frame BackgroundColor="Black" CornerRadius="10" HeightRequest="25" WidthRequest="25" />
            <Frame BackgroundColor="Black" CornerRadius="10" HeightRequest="25" WidthRequest="25" />





        </VerticalStackLayout>

    </Grid>




        

</ContentPage>
    